# ─── Database ───────────────────────────────────────────────────────────
# Leave empty for local mode: an embedded Postgres (PGlite) stored in .data/pglite, migrated on
# startup, with the market maker + agent running inside `pnpm dev`. Nothing to install.
# For Neon, paste the pooled connection string from https://console.neon.tech, then `pnpm db:migrate`.
DATABASE_URL=
# Folder for the embedded database (default .data). Docker sets it to the volume.
MINT_DATA_DIR=

# ─── Secrets ────────────────────────────────────────────────────────────
# 32 random bytes, base64. Generate both with: pnpm secrets
# Encrypts every wallet secret key at rest (AES-256-GCM). Losing it = losing every wallet.
WALLET_ENCRYPTION_KEY=
# Peppers OTP and session hashes.
SESSION_SECRET=

# ─── Email (login codes) ────────────────────────────────────────────────
# Optional. Without a Resend key, `pnpm dev` simulates email: the code is typed into the form for you.
# A production server without a key prints codes to its console instead, unless SIMULATE_EMAIL=true
# (local testing only: it lets anyone sign in as any address).
RESEND_API_KEY=
SIMULATE_EMAIL=
EMAIL_FROM=MINT <login@yourdomain.com>

# ─── AI (Groq) ──────────────────────────────────────────────────────────
GROQ_API_KEY=
# Any Groq model with tool calling.
GROQ_MODEL=openai/gpt-oss-120b

# ─── Stellar ────────────────────────────────────────────────────────────
# Trading and payments run on testnet; market analysis reads mainnet prices.
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_MAINNET_HORIZON_URL=https://horizon.stellar.org
# Circle testnet USDC issuer — check https://developers.circle.com/stablecoins/usdc-contract-addresses
USDC_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5
# Mainnet USDC issuer used only for price reference.
MAINNET_USDC_ISSUER=GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN

# Platform treasury: sponsors account reserves, pays every fee (fee-bump), runs the test-USDC faucet.
# Created by: pnpm stellar:bootstrap
TREASURY_SECRET=
# Market-maker bot account that mirrors every mainnet market onto testnet. Created by bootstrap.
MARKET_MAKER_SECRET=
# Issues MINT's testnet copies of BTC, ETH, EURC, AQUA, yXLM, CETES and USTRY. Created by bootstrap.
ISSUER_SECRET=

# ─── Soroban contracts ─────────────────────────────────────────────────
# Soroban RPC (contract calls). Contract ids below are written by: pnpm contracts:build && pnpm contracts:deploy
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
# SEP-40 price feed the worker publishes mainnet reference prices to (admin: treasury).
PRICE_FEED_CONTRACT_ID=
# Scheduled & recurring payments (pull payments over USDC's asset contract).
RECURRING_PAYMENTS_CONTRACT_ID=
# Uploaded guardrail-vault code; each user's vault is deployed from it.
GUARDRAIL_VAULT_WASM_HASH=
# Soroswap router the vaults trade through (testnet address from soroswap/core public/testnet.contracts.json).
SOROSWAP_ROUTER_ID=CCJUD55AG6W5HAI5LRVNKAE5WDP5XGZBUDS5WNTIVDU7O264UZZE7BRD

# ─── x402 (pay-per-request data) ───────────────────────────────────────
# Where this app is reachable. The agent buys MINT's own paid market feed from here by default.
APP_URL=http://localhost:3000
# Facilitator that verifies and settles x402 payments. Any x402 v2 Stellar facilitator works; if it
# can't be reached MINT settles in-process (fees paid by the treasury). "local" skips the remote one.
X402_FACILITATOR_URL=https://x402.org/facilitator
# Paid endpoints the agent may buy from, comma-separated. Empty = MINT's own /api/x402/signals.
X402_DATA_SOURCES=

# Domain used for federation handles: alex*FEDERATION_DOMAIN
FEDERATION_DOMAIN=localhost:3000
