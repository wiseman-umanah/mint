{
  "name": "mint",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NEXT_MANUAL_SIG_HANDLE=true NEXT_EXIT_TIMEOUT_MS=10000 next dev",
    "build": "next build",
    "start": "NEXT_MANUAL_SIG_HANDLE=true next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "db:studio": "drizzle-kit studio",
    "secrets": "node -e \"const c=require('node:crypto');console.log('WALLET_ENCRYPTION_KEY='+c.randomBytes(32).toString('base64'));console.log('SESSION_SECRET='+c.randomBytes(32).toString('base64'))\"",
    "stellar:bootstrap": "tsx --env-file=.env.local scripts/bootstrap.ts",
    "worker": "tsx --env-file=.env.local scripts/worker.ts",
    "contracts:build": "cd contracts && stellar contract build",
    "contracts:test": "cargo test --manifest-path contracts/Cargo.toml",
    "contracts:deploy": "tsx --env-file=.env.local scripts/contracts.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:reset": "tsx scripts/db-reset.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@neondatabase/serverless": "^1.2.0",
    "@stellar/stellar-sdk": "^17.4.0",
    "drizzle-orm": "^0.45.4",
    "groq-sdk": "^1.6.0",
    "lightweight-charts": "5.2.1",
    "next": "16.4.5",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remixicon": "^4.9.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.15.0"
}
